# Only the sources of the frontend, the backend, the engine and the pipeline go into the image build
*
!Dockerfile
!frontend
!backend
!packages
!pipeline
**/node_modules
**/*.spec.ts
frontend/dist
frontend/.angular
frontend/public/data-pack
frontend/public/build-info.json
frontend/e2e
frontend/playwright-report
frontend/test-results
backend/test
pipeline/.venv
pipeline/tests
pipeline/scripts
**/__pycache__
