{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "maplibre-gl-worker.mjs",
                "input": "node_modules/maplibre-gl/dist",
                "output": "."
              },
              {
                "glob": "LICENSE",
                "input": "node_modules/@fontsource/roboto",
                "output": "licences/roboto"
              },
              {
                "glob": "LICENSE",
                "input": "node_modules/material-symbols",
                "output": "licences/material-symbols"
              }
            ],
            "styles": [
              "node_modules/@fontsource/roboto/300.css",
              "node_modules/@fontsource/roboto/400.css",
              "node_modules/@fontsource/roboto/500.css",
              "node_modules/@fontsource/roboto/700.css",
              "node_modules/material-symbols/outlined.css",
              "src/styles.scss"
            ],
            "baseHref": "./",
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.5MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": [
                    "data-pack/**"
                  ]
                },
                {
                  "glob": "**/*",
                  "input": "e2e/data-pack",
                  "output": "data-pack"
                },
                {
                  "glob": "maplibre-gl-worker.mjs",
                  "input": "node_modules/maplibre-gl/dist",
                  "output": "."
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            },
            "development": {
              "buildTarget": "frontend:build:development"
            },
            "e2e": {
              "buildTarget": "frontend:build:e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "providersFile": "src/test-providers.ts",
            "coverageInclude": [
              "src/app/**/*.ts"
            ],
            "coverageExclude": [
              "src/**/*.spec.ts"
            ],
            "coverageReporters": [
              "text-summary",
              "json-summary"
            ]
          }
        }
      }
    }
  }
}
