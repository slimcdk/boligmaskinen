{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node tools/build-info.mjs",
    "start": "ng serve",
    "prebuild": "node tools/build-info.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node tools/check-i18n.mjs && node tools/check-readme.mjs",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "screenshots": "playwright test -c playwright.screenshots.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@fontsource/roboto": "5.3.0",
    "@jsverse/transloco": "8.4.0",
    "maplibre-gl": "^6.16.0",
    "material-symbols": "0.48.3",
    "pmtiles": "^4.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
